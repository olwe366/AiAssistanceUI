<Window x:Class="AiAssisanceUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#2C3E50">

    <Window.Resources>
        <Style x:Key="ChatBubbleUser" TargetType="Border">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="10,5,50,5"/>
        </Style>

        <Style x:Key="ChatBubbleBot" TargetType="Border">
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="50,5,10,5"/>
        </Style>

        <Style x:Key="MessageTextUser" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MessageTextBot" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderBrush="#229954" 
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#229954"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VoiceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderBrush="#C0392B" 
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with ASCII Art -->
        <Border Grid.Row="0" Background="#34495E" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ASCII Art -->
                <TextBlock Grid.Column="0" 
                           FontFamily="Consolas" 
                           FontSize="10" 
                           Foreground="#27AE60"
                           Text="
    ╔══════════════════════════════════════════════════════════╗
    ║     ██████╗██╗   ██╗██████╗ ███████╗██████╗ ███████╗     ║
    ║    ██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗██╔════╝     ║
    ║    ██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝███████╗     ║
    ║    ██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗╚════██║     ║
    ║    ╚██████╗   ██║   ██████╔╝███████╗██║  ██║███████║     ║
    ║     ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝╚══════╝     ║
    ║                 Cybersecurity Awareness                  ║
    ╚══════════════════════════════════════════════════════════╝"
                           Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="🤖 Cybersecurity Guardian" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Messages Area -->
        <ScrollViewer Grid.Row="1" 
                      x:Name="ChatScrollViewer" 
                      Background="#F5F6FA"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChatMessagesPanel" 
                       Orientation="Vertical" 
                       Margin="10"
                       VerticalAlignment="Top"/>
        </ScrollViewer>

        <!-- Sentiment Indicator -->
        <Border Grid.Row="2" Background="#ECF0F1" Padding="10" Height="40">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎭 Detected Sentiment: " 
                          FontSize="12" 
                          FontWeight="Bold" 
                          Foreground="#7F8C8D"/>
                <TextBlock x:Name="SentimentIndicator" 
                          FontSize="12" 
                          Foreground="#27AE60"
                          Text="Neutral"/>
            </StackPanel>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="3" Background="White" Padding="15" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInputTextBox" 
                        Grid.Column="0"
                        Height="40"
                        FontSize="14"
                        Padding="10,5"
                        VerticalContentAlignment="Center"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        TextChanged="UserInputTextBox_TextChanged"
                        KeyDown="UserInputTextBox_KeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="White" 
                                    BorderBrush="#BDC3C7" 
                                    BorderThickness="1" 
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="8,0"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <Button x:Name="VoiceInputButton" 
                       Grid.Column="1"
                       Style="{StaticResource VoiceButtonStyle}"
                       Content="🎤 Voice"
                       Click="VoiceInputButton_Click"/>

                <Button x:Name="SendButton" 
                       Grid.Column="2"
                       Style="{StaticResource SendButtonStyle}"
                       Content="Send ➤"
                       Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>